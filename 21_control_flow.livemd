# Elixir Koans - 21 Control Flow

```elixir
import ExUnit.Assertions
```

## Intro

Control Flow - Making decisions and choosing paths

## If statements evaluate conditions

```elixir
result = if true, do: "yes", else: "no"
```

```elixir
assert result == ___
```

## If can be written in block form

```elixir
result =
  if 1 + 1 == 2 do
    "math works"
  else
    "math is broken"
  end
```

```elixir
assert result == ___
```

## Unless is the opposite of if

```elixir
result = unless false, do: "will execute", else: "will not execute"
```

```elixir
assert result == ___
```

## Nil and false are falsy, everything else is truthy

```elixir
assert if(nil, do: "truthy", else: "falsy") == ___
```

```elixir
assert if(false, do: "truthy", else: "falsy") == ___
```

```elixir
assert if(0, do: "truthy", else: "falsy") == ___
```

```elixir
assert if("", do: "truthy", else: "falsy") == ___
```

```elixir
assert if([], do: "truthy", else: "falsy") == ___
```

## Case matches against patterns

```elixir
result =
  case {1, 2, 3} do
    {4, 5, 6} -> "no match"
    {1, x, 3} -> "matched with x = #{x}"
  end
```

```elixir
assert result == ___
```

## Case can have multiple clauses with different patterns

```elixir
check_number = fn x ->
  case x do
    0 -> "zero"
    n when n > 0 -> "positive"
    n when n < 0 -> "negative"
  end
end
```

```elixir
assert check_number.(5) == ___
```

```elixir
assert check_number.(0) == ___
```

```elixir
assert check_number.(-3) == ___
```

## Case clauses are tried in order until one matches

```elixir
check_list = fn list ->
  case list do
    [] -> "empty"
    [_] -> "one element"
    [_, _] -> "two elements"
    _ -> "many elements"
  end
end
```

```elixir
assert check_list.([]) == ___
```

```elixir
assert check_list.([:a]) == ___
```

```elixir
assert check_list.([:a, :b]) == ___
```

```elixir
assert check_list.([:a, :b, :c, :d]) == ___
```

## Cond evaluates conditions until one is truthy

```elixir
temperature = 25

weather =
  cond do
    temperature < 0 -> "freezing"
    temperature < 10 -> "cold"
    temperature < 25 -> "cool"
    temperature < 30 -> "warm"
    true -> "hot"
  end
```

```elixir
assert weather == ___
```

## Cond requires at least one clause to be true

```elixir
safe_divide = fn x, y ->
  cond do
    y == 0 -> {:error, "division by zero"}
    true -> {:ok, x / y}
  end
end
```

```elixir
assert safe_divide.(10, 2) == ___
```

```elixir
assert safe_divide.(10, 0) == ___
```

## Case can destructure complex patterns

```elixir
parse_response = fn response ->
  case response do
    {:ok, %{status: 200, body: body}} -> "Success: #{body}"
    {:ok, %{status: status}} when status >= 400 -> "Client error: #{status}"
    {:ok, %{status: status}} when status >= 500 -> "Server error: #{status}"
    {:error, reason} -> "Request failed: #{reason}"
  end
end
```

```elixir
assert parse_response.({:ok, %{status: 200, body: "Hello"}}) == ___
```

```elixir
assert parse_response.({:ok, %{status: 404}}) == ___
```

```elixir
assert parse_response.({:error, :timeout}) == ___
```

## Guards in case can use complex expressions

```elixir
categorize = fn number ->
  case number do
    n when is_integer(n) and n > 0 and rem(n, 2) == 0 -> "positive even integer"
    n when is_integer(n) and n > 0 and rem(n, 2) == 1 -> "positive odd integer"
    n when is_integer(n) and n < 0 -> "negative integer"
    n when is_float(n) -> "float"
    _ -> "other"
  end
end
```

```elixir
assert categorize.(4) == ___
```

```elixir
assert categorize.(3) == ___
```

```elixir
assert categorize.(-5) == ___
```

```elixir
assert categorize.(3.14) == ___
```

```elixir
assert categorize.("hello") == ___
```

## Multiple conditions can be checked in sequence

```elixir
process_user = fn user ->
  if user.active do
    if user.verified do
      if user.premium do
        "premium verified active user"
      else
        "verified active user"
      end
    else
      "unverified active user"
    end
  else
    "inactive user"
  end
end

user = %{active: true, verified: true, premium: false}
```

```elixir
assert process_user.(user) == ___
```

